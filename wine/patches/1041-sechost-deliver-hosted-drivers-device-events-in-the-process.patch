diff --git a/dlls/sechost/service.c b/dlls/sechost/service.c
index f05fd2d..7f1143c 100644
--- a/dlls/sechost/service.c
+++ b/dlls/sechost/service.c
@@ -1988,9 +1988,29 @@ struct device_notify
     WCHAR *path;
     HANDLE handle;
     device_notify_callback callback;
+    UINT64 serial;  /* registrations are numbered in order */
     DEV_BROADCAST_HDR header[]; /* variable size */
 };
 
+static UINT64 device_notify_serial;
+
+/* Device events from drivers that run in this process (ntoskrnl's
+ * wine_ntoskrnl_host_start), for a process with no plug and play service:
+ * ntoskrnl turns this on before its drivers start and queues their events
+ * here, and the notification thread delivers them in place of the service's. */
+struct local_device_event
+{
+    struct list entry;
+    DWORD code;
+    UINT64 serial;  /* the last registration when it was queued */
+    WCHAR *path;
+    BYTE data[];
+};
+
+static BOOL local_device_events_on;
+static struct list local_device_events = LIST_INIT(local_device_events);
+static HANDLE local_device_queued;
+
 C_ASSERT( sizeof(struct device_notify) == offsetof(struct device_notify, header[0]) );
 
 static struct device_notify *device_notify_copy( struct device_notify *notify, DEV_BROADCAST_HDR *header )
@@ -2033,22 +2053,78 @@ static BOOL notification_filter_matches( DEV_BROADCAST_HDR *filter, const WCHAR
     return TRUE;
 }
 
+/* Calls the callbacks of the registrations an event matches, up to the given one: a program that registers
+ * after an event was queued was not there when it happened. */
+static void dispatch_device_event( DWORD code, const WCHAR *path, DEV_BROADCAST_HDR *header, UINT64 serial )
+{
+    struct device_notify *notify, *event, *next;
+    struct list events = LIST_INIT(events);
+
+    /* Make a copy to avoid a hang if a callback tries to register or unregister for notifications. */
+    EnterCriticalSection( &service_cs );
+    LIST_FOR_EACH_ENTRY( notify, &device_notify_list, struct device_notify, entry )
+    {
+        if (notify->serial > serial) continue;
+        if (!notification_filter_matches( notify->header, notify->path, header, path )) continue;
+        if (!(event = device_notify_copy( notify, header ))) break;
+        list_add_tail( &events, &event->entry );
+    }
+    LeaveCriticalSection(&service_cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE( event, next, &events, struct device_notify, entry )
+    {
+        event->callback( event->handle, code, event->header );
+        list_remove( &event->entry );
+        free( event );
+    }
+}
+
+/* Delivers the events this process's own drivers queue (__wine_queue_device_event), for as long as the process
+ * runs. */
+static DWORD local_device_notify_loop(void)
+{
+    struct local_device_event *event;
+    struct list *head;
+
+    while (!WaitForSingleObject( local_device_queued, INFINITE ))
+    {
+        for (;;)
+        {
+            EnterCriticalSection( &service_cs );
+            if ((head = list_head( &local_device_events ))) list_remove( head );
+            LeaveCriticalSection( &service_cs );
+            if (!head) break;
+
+            event = LIST_ENTRY( head, struct local_device_event, entry );
+            dispatch_device_event( event->code, event->path, (DEV_BROADCAST_HDR *)event->data, event->serial );
+            free( event->path );
+            free( event );
+        }
+    }
+    ERR( "wait failed, error %lu\n", GetLastError() );
+    return 1;
+}
+
 static DWORD WINAPI device_notify_proc( void *arg )
 {
     WCHAR endpoint[] = L"\\pipe\\wine_plugplay";
     WCHAR protseq[] = L"ncacn_np";
     RPC_WSTR binding_str;
     DWORD err = ERROR_SUCCESS;
-    struct device_notify *notify, *event, *next;
-    struct list events = LIST_INIT(events);
     plugplay_rpc_handle handle = NULL;
     DWORD code = 0;
     unsigned int size;
     WCHAR *path;
     BYTE *buf;
+    BOOL local;
 
     SetThreadDescription( GetCurrentThread(), L"wine_sechost_device_notify" );
 
+    EnterCriticalSection( &service_cs );
+    local = local_device_events_on;
+    LeaveCriticalSection( &service_cs );
+    if (local) return local_device_notify_loop();
+
     if ((err = RpcStringBindingComposeW( NULL, protseq, NULL, endpoint, NULL, &binding_str )))
     {
         ERR("RpcStringBindingCompose() failed, error %#lx\n", err);
@@ -2074,6 +2150,12 @@ static DWORD WINAPI device_notify_proc( void *arg )
 
     if (!handle)
     {
+        RpcBindingFree( &plugplay_binding_handle );
+        /* Started before the drivers this process hosts turned their events on. */
+        EnterCriticalSection( &service_cs );
+        local = local_device_events_on;
+        LeaveCriticalSection( &service_cs );
+        if (local) return local_device_notify_loop();
         ERR("failed to open RPC handle, error %lu\n", err);
         return 1;
     }
@@ -2099,22 +2181,7 @@ static DWORD WINAPI device_notify_proc( void *arg )
             break;
         }
 
-        /* Make a copy to avoid a hang if a callback tries to register or unregister for notifications. */
-        EnterCriticalSection( &service_cs );
-        LIST_FOR_EACH_ENTRY( notify, &device_notify_list, struct device_notify, entry )
-        {
-            if (!notification_filter_matches( notify->header, notify->path, (DEV_BROADCAST_HDR *)buf, path )) continue;
-            if (!(event = device_notify_copy( notify, (DEV_BROADCAST_HDR *)buf ))) break;
-            list_add_tail( &events, &event->entry );
-        }
-        LeaveCriticalSection(&service_cs);
-
-        LIST_FOR_EACH_ENTRY_SAFE( event, next, &events, struct device_notify, entry )
-        {
-            event->callback( event->handle, code, event->header );
-            list_remove( &event->entry );
-            free( event );
-        }
+        dispatch_device_event( code, path, (DEV_BROADCAST_HDR *)buf, ~(UINT64)0 );
 
         MIDL_user_free(buf);
         MIDL_user_free(path);
@@ -2133,6 +2200,45 @@ static DWORD WINAPI device_notify_proc( void *arg )
     return 0;
 }
 
+/******************************************************************************
+ *     __wine_queue_device_event   (sechost.@)
+ *
+ * For ntoskrnl when it runs drivers in an ordinary process with no plug and
+ * play service (wine_ntoskrnl_host_start). Called once with no data before the
+ * drivers start: device events then come only from this process, and the
+ * notification thread waits for them instead of for the service. Each later
+ * call queues one event for the registrations made so far. The notification
+ * thread delivers it, never the caller: a driver's thread must not wait on a
+ * window that may be waiting on that driver. Without a registration the event
+ * is dropped.
+ */
+void WINAPI __wine_queue_device_event( const WCHAR *path, DWORD code, const void *data, unsigned int size )
+{
+    struct local_device_event *event;
+
+    EnterCriticalSection( &service_cs );
+    if (!data)
+    {
+        if (!local_device_queued) local_device_queued = CreateEventW( NULL, FALSE, FALSE, NULL );
+        if (local_device_queued) local_device_events_on = TRUE;
+        else ERR( "no event, error %lu: device events are lost\n", GetLastError() );
+    }
+    else if (local_device_events_on && size >= sizeof(DEV_BROADCAST_HDR) && !list_empty( &device_notify_list ) &&
+             (event = malloc( offsetof(struct local_device_event, data[size]) )))
+    {
+        if ((event->path = wcsdup( path ? path : L"" )))
+        {
+            event->code = code;
+            event->serial = device_notify_serial;
+            memcpy( event->data, data, size );
+            list_add_tail( &local_device_events, &event->entry );
+            SetEvent( local_device_queued );
+        }
+        else free( event );
+    }
+    LeaveCriticalSection( &service_cs );
+}
+
 /******************************************************************************
  *     I_ScRegisterDeviceNotification   (sechost.@)
  */
@@ -2172,6 +2278,7 @@ HDEVNOTIFY WINAPI I_ScRegisterDeviceNotification( HANDLE handle, DEV_BROADCAST_H
     }
 
     EnterCriticalSection( &service_cs );
+    notify->serial = ++device_notify_serial;
     list_add_tail( &device_notify_list, &notify->entry );
 
     if (!device_notify_thread)
