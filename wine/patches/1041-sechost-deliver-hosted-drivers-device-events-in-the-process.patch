index bdfcbed..f782258 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4396,6 +4396,8 @@ static const GUID GUID_DEVINTERFACE_WINEXINPUT = {0x6c53d5fd, 0x6480, 0x440f, {0
 static const GUID hid_interface_class = {0x4d1e55b2, 0xf16f, 0x11cf, {0x88, 0xcb, 0x00, 0x11, 0x11, 0x00, 0x00, 0x30}};
 static const GUID *host_gamepad_class = &GUID_DEVINTERFACE_WINEXINPUT;
 
+void (WINAPI *hosted_queue_device_event)( const WCHAR *path, DWORD code, const void *data, unsigned int size );
+
 void hosted_interface_enabled( const GUID *interface_class )
 {
     if (host_gamepad && IsEqualGUID( interface_class, host_gamepad_class ) &&
@@ -4444,6 +4446,18 @@ NTSTATUS CDECL wine_ntoskrnl_host_start( const WCHAR *driver_name, DWORD timeout
             host_gamepads = pads[0] - '0';
     }
 
+    /* There is no plug and play service to send device events to: the programs that asked to be told are in this
+     * process, and sechost tells them. Found here, before any driver runs, and not from a driver's thread, which
+     * must not wait for the loader. */
+    if (!hosted_queue_device_event)
+    {
+        HMODULE sechost = LoadLibraryW( L"sechost.dll" );
+
+        if (sechost) hosted_queue_device_event = (void *)GetProcAddress( sechost, "__wine_queue_device_event" );
+        if (hosted_queue_device_event) hosted_queue_device_event( NULL, 0, NULL, 0 );
+        else WARN( "programs will not be told when devices come or go\n" );
+    }
+
     GetSystemDirectoryW( path, MAX_PATH );
     wcscat( path, L"\\drivers" );
     AddDllDirectory( path );
